# Copy to .env.local and fill in. Never commit .env.local.

# Firebase web app (Project settings → General → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Project settings → Service accounts → Generate new private key)
# Server-only. Used by /api/stream-token to verify users.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stream Video (https://dashboard.getstream.io → your app)
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# EmailJS (https://dashboard.emailjs.com)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_TEMPLATE_APPLICATION=
NEXT_PUBLIC_EMAILJS_TEMPLATE_INTERVIEW=
NEXT_PUBLIC_EMAILJS_TEMPLATE_REJECTION=
NEXT_PUBLIC_EMAILJS_TEMPLATE_OFFER=

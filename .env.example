# Copy to .env.local and fill in. Never commit .env.local, and never put real keys in this file.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stream Video (https://dashboard.getstream.io → your app)
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# EmailJS (https://dashboard.emailjs.com)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_TEMPLATE_APPLICATION=
NEXT_PUBLIC_EMAILJS_TEMPLATE_INTERVIEW=
NEXT_PUBLIC_EMAILJS_TEMPLATE_REJECTION=
NEXT_PUBLIC_EMAILJS_TEMPLATE_OFFER=

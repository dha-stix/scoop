rules_version = '2';

// CVs live at cvs/{candidateUid}/{jobId}/{file}.
// Candidates upload their own; signed-in users can read via the download URL
// stored on the application (which only the candidate and hiring company can see).
service firebase.storage {
  match /b/{bucket}/o {
    match /cvs/{uid}/{jobId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)');
      allow delete: if request.auth != null;
    }
  }
}
